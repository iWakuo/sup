{
    "version": "4.0.1",
    "description": "An easy-to-use, multi-track audio editor and recorder",
    "homepage": "https://www.audacityteam.org",
    "license": {
        "identifier": "GPL-2.0-or-later|GPL-3.0-only|CC-BY-3.0",
        "url": "https://github.com/audacity/audacity/blob/master/LICENSE.txt"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/audacity/audacity/releases/download/Audacity-4.0.1/audacity-win-4.0.1-x86_64.7z",
            "hash": "9c5e0379626dee8a573af91ba5355311b9001dcf310294dd4dc9aa6887593d03"
        },
        "arm64": {
            "url": "https://github.com/audacity/audacity/releases/download/Audacity-4.0.1/audacity-win-4.0.1-arm64.7z",
            "hash": "bafa562f9fc3960eae50ac64b656360b5bd2824af3396ed0809551a1f8eb716e"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\\Audacity-*\" -Directory | ForEach-Object { movedir $_.FullName $dir }",
        "if (!(Test-Path \"$persist_dir\")) { New-Item -ItemType Directory -Path \"$persist_dir\" -Force | Out-Null }",
        "if (!(Test-Path \"$env:APPDATA\\Audacity\")) { New-Item -ItemType Directory -Path \"$env:APPDATA\\Audacity\" -Force | Out-Null }"
    ],
    "bin": [
        [
            "bin\\Audacity4.exe",
            "audacity"
        ]
    ],
    "shortcuts": [
        [
            "bin\\Audacity4.exe",
            "Audacity"
        ]
    ],
    "persist": [
        [
            "bin\\Portable Settings",
            "Portable Settings"
        ]
    ],
    "post_install": [
        "$appdataPath = Join-Path $env:APPDATA 'Audacity'",
        "if (Test-Path $appdataPath) {",
        "    $item = Get-Item $appdataPath -Force",
        "    if ($item.LinkType -eq 'Junction') { Remove-Item $appdataPath -Force }",
        "    elseif ((Get-ChildItem $appdataPath -Force -ErrorAction SilentlyContinue | Measure-Object).Count -eq 0) { Remove-Item $appdataPath -Force -Recurse }",
        "}",
        "if (!(Test-Path $appdataPath)) { New-Item -ItemType Junction -Path $appdataPath -Target $persist_dir -Force | Out-Null }"
    ],
    "checkver": {
        "github": "https://github.com/audacity/audacity",
        "regex": "Audacity-([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/audacity/audacity/releases/download/Audacity-$version/audacity-win-$version-x86_64.7z"
            },
            "arm64": {
                "url": "https://github.com/audacity/audacity/releases/download/Audacity-$version/audacity-win-$version-arm64.7z"
            }
        },
        "hash": {
            "url": "$baseurl/CHECKSUMS.txt",
            "regex": "$basename.*?$sha256"
        }
    }
}
