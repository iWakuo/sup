{
    "version": "4.0.2",
    "description": "An easy-to-use, multi-track audio editor and recorder",
    "homepage": "https://www.audacityteam.org",
    "license": {
        "identifier": "GPL-2.0-or-later|GPL-3.0-only|CC-BY-3.0",
        "url": "https://github.com/audacity/audacity/blob/master/LICENSE.txt"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/audacity/audacity/releases/download/Audacity-4.0.2/audacity-win-4.0.2-x86_64.msi",
            "hash": "ff6cad670befee96fee563056965fa5e17bfa8c7ea3aba10c461c18799409e22"
        },
        "arm64": {
            "url": "https://github.com/audacity/audacity/releases/download/Audacity-4.0.2/audacity-win-4.0.2-arm64.msi",
            "hash": "78a11f84f3f28be7dee932f99a2da2f6a8ecb60ac1ee8fe2ff3c85f0f6a5a9d8"
        }
    },
    "extract_dir": "Audacity 4",
    "shortcuts": [
        [
            "bin/Audacity4.exe",
            "Audacity"
        ]
    ],
    "pre_install": [
        "$appLocal = Join-Path $env:LOCALAPPDATA 'Audacity'",
        "$appRoaming = Join-Path $env:APPDATA 'Audacity'",
        "$persistLocal = Join-Path $persist_dir 'Local'",
        "$persistRoaming = Join-Path $persist_dir 'Roaming'",
        "New-Item -ItemType Directory -Path $persistLocal -Force | Out-Null",
        "New-Item -ItemType Directory -Path $persistRoaming -Force | Out-Null",
        "if ((Test-Path $appLocal) -and ((Get-Item -Force $appLocal).LinkType -eq 'Junction')) { cmd /c rmdir \"$appLocal\" }",
        "if ((Test-Path $appLocal) -and ((Get-Item -Force $appLocal).LinkType -ne 'Junction')) { Move-Item -Path (Join-Path $appLocal '*') -Destination $persistLocal -Force -ErrorAction SilentlyContinue; Remove-Item -Path $appLocal -Recurse -Force }",
        "if ((Test-Path $appRoaming) -and ((Get-Item -Force $appRoaming).LinkType -eq 'Junction')) { cmd /c rmdir \"$appRoaming\" }",
        "if ((Test-Path $appRoaming) -and ((Get-Item -Force $appRoaming).LinkType -ne 'Junction')) { Move-Item -Path (Join-Path $appRoaming '*') -Destination $persistRoaming -Force -ErrorAction SilentlyContinue; Remove-Item -Path $appRoaming -Recurse -Force }",
        "New-Item -ItemType Junction -Path $appLocal -Target $persistLocal -Force | Out-Null",
        "New-Item -ItemType Junction -Path $appRoaming -Target $persistRoaming -Force | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "$appLocal = Join-Path $env:LOCALAPPDATA 'Audacity'",
            "$appRoaming = Join-Path $env:APPDATA 'Audacity'",
            "if (Test-Path $appLocal) { cmd /c rmdir \"$appLocal\" }",
            "if (Test-Path $appRoaming) { cmd /c rmdir \"$appRoaming\" }"
        ]
    },
    "checkver": {
        "github": "https://github.com/audacity/audacity",
        "regex": "Audacity-([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/audacity/audacity/releases/download/Audacity-$version/audacity-win-$version-x86_64.msi"
            },
            "arm64": {
                "url": "https://github.com/audacity/audacity/releases/download/Audacity-$version/audacity-win-$version-arm64.msi"
            }
        },
        "hash": {
            "url": "$baseurl/CHECKSUMS.txt",
            "regex": "$basename.*?$sha256"
        }
    }
}
