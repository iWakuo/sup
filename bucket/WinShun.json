{
    "version": "0.16.0",
    "description": "免费开源的 Windows 快速搜索启动器：拼音秒搜文件、Word/Excel/PDF 全文搜索、剪贴板历史、任务栏搜索框、插件与 MCP 服务器。Everything / Listary 替代品。",
    "homepage": "https://github.com/LingCore/WinShun",
    "license": "MIT",
    "notes": [
        "需要管理员权限才能启用键盘拦截、NTFS 索引等功能，首次运行请以管理员身份启动。",
        "配置持久化在 $persist_dir\\data\\WinShun\\WinShun.ini，通过 persist 机制与安装目录内的 data\\WinShun 目录整体保持同步，升级/重装不丢失。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/LingCore/WinShun/releases/download/v0.16.0/WinShun-0.16.0-x64-portable.zip",
            "hash": "e1b587aa0cd1f9340ec92713d9444abd389aaa52660db153a9e47d4e7b3ac04c"
        }
    },
    "extract_dir": "WinShun",
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\data\")) {",
        "    New-Item -ItemType Directory -Path \"$dir\\data\" -Force | Out-Null",
        "}"
    ],
    "shortcuts": [
        ["WinShun.exe", "WinShun"]
    ],
    "persist": [
        "data\\WinShun"
    ],
    "checkver": {
        "github": "https://github.com/LingCore/WinShun"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LingCore/WinShun/releases/download/v$version/WinShun-$version-x64-portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
