{
    "version": "1.0.10",
    "description": "Run LLMs on AMD Ryzen™ AI NPUs in minutes.",
    "homepage": "https://fastflowlm.com/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/FastFlowLM/FastFlowLM/releases/download/v1.0.10/fastflowlm_1.0.10_windows_amd64.zip",
            "hash": "a7063890d7b91037a07f381a396a0d7787ebdb69e1b03280971faf0a80f35b73"
        }
    },
    "bin": "flm.exe",
    "pre_install": [
        "$sub = Get-ChildItem -LiteralPath $dir -Directory -Filter 'fastflowlm-windows-*' -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($sub) { Get-ChildItem -LiteralPath $sub.FullName -Force | Move-Item -Destination $dir -Force; Remove-Item -LiteralPath $sub.FullName -Recurse -Force }"
    ],
    "post_install": [
        "$flm = Join-Path $env:USERPROFILE '.flm'",
        "$persist = Join-Path $persist_dir 'USERPROFILE'",
        "if (-not (Test-Path -LiteralPath $persist)) { New-Item -ItemType Directory -Path $persist -Force | Out-Null }",
        "if (Test-Path -LiteralPath $flm) {",
        "    $item = Get-Item -LiteralPath $flm -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Remove-Item -LiteralPath $flm -Force -Recurse",
        "    } else {",
        "        Get-ChildItem -LiteralPath $flm -Force | ForEach-Object {",
        "            $dest = Join-Path $persist $_.Name",
        "            if (-not (Test-Path -LiteralPath $dest)) { Move-Item -LiteralPath $_.FullName -Destination $persist -Force }",
        "        }",
        "        $left = @(Get-ChildItem -LiteralPath $flm -Force)",
        "        if ($left.Count -eq 0) { Remove-Item -LiteralPath $flm -Force -Recurse } else { throw \"Cannot empty $flm; merge remaining files into $persist manually.\" }",
        "    }",
        "}",
        "New-Item -ItemType Junction -Path $flm -Target $persist | Out-Null"
    ],
    "pre_uninstall": "if (Test-Path -LiteralPath \"$env:USERPROFILE\\.flm\") { Remove-Item -LiteralPath \"$env:USERPROFILE\\.flm\" -Force -Recurse -ErrorAction SilentlyContinue }",
    "persist": "USERPROFILE",
    "checkver": {
        "github": "https://github.com/FastFlowLM/FastFlowLM"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/FastFlowLM/FastFlowLM/releases/download/v$version/fastflowlm_$version_windows_amd64.zip"
            }
        }
    }
}
