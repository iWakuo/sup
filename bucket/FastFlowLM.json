{
    "version": "1.0.9",
    "description": "Run LLMs on AMD Ryzen™ AI NPUs in minutes.",
    "homepage": "https://fastflowlm.com/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/FastFlowLM/FastFlowLM/releases/download/v1.0.9/fastflowlm_1.0.9_windows_amd64.zip",
            "hash": "5edd8a04919aa907af5f53ff81464726210291d601c144615ddc5b2cb4f0afc7"
        }
    },
    "bin": "flm.exe",
    "pre_install": [
        "Get-ChildItem \"$dir\" \"fastflowlm-windows-*\" -Directory | Get-ChildItem | Move-Item -Destination \"$dir\\\"",
        "if (Test-Path \"$env:USERPROFILE\\.flm\" -PathType Container) {",
        "    Get-ChildItem \"$env:USERPROFILE\\.flm\" -Force | Move-Item -Destination \"$persist_dir\\USERPROFILE\" -Force",
        "    Remove-Item \"$env:USERPROFILE\\.flm\" -Force -Recurse",
        "}"
    ],
    "post_install": [
        "New-Item -ItemType Junction -Path \"$env:USERPROFILE\\.flm\" -Target \"$persist_dir\\USERPROFILE\" -Force | Out-Null"
    ],
    "pre_uninstall": "if (Test-Path \"$env:USERPROFILE\\.flm\") { Remove-Item \"$env:USERPROFILE\\.flm\" -Force -Recurse -ErrorAction SilentlyContinue }",
    "persist": "USERPROFILE",
    "checkver": {
        "github": "https://github.com/FastFlowLM/FastFlowLM"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/FastFlowLM/FastFlowLM/releases/download/v$version/fastflowlm_$version_windows_amd64.zip"
            }
        }
    }
}
