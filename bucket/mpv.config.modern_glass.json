{
    "version": "1.9.28",
    "description": "Modern Glass 中文 mpv 配置包，自动部署到 mpv 的 portable_config 持久化目录，并自动开启 include 选项。",
    "homepage": "https://github.com/akFace/mpv.config",
    "license": "Unknown",
    "depends": "mpv",
    "url": "https://github.com/akFace/mpv.config/releases/download/v1.9.28/modern_glass_zh.zip",
    "hash": "",
    "installer": {
        "script": [
            "$mpvConfigDir = Join-Path $scoopdir 'persist\\mpv\\portable_config'",
            "if (-not (Test-Path $mpvConfigDir)) {",
            "    New-Item -ItemType Directory -Path $mpvConfigDir -Force | Out-Null",
            "}",
            "Write-Host \"正在部署 mpv 配置到 $mpvConfigDir ...\" -ForegroundColor Cyan",
            "Copy-Item -Path (Join-Path $dir '*') -Destination $mpvConfigDir -Recurse -Force",
            "",
            "# 开启 mpv.conf 中的 include 选项：优先取消注释；无注释行时再追加到末尾",
            "$mpvConfPath = Join-Path $mpvConfigDir 'mpv.conf'",
            "if (Test-Path $mpvConfPath) {",
            "    $utf8NoBom = New-Object System.Text.UTF8Encoding($false)",
            "    $content = [System.IO.File]::ReadAllText($mpvConfPath, [System.Text.Encoding]::UTF8)",
            "",
            "    # 1. 已存在生效的 include 行（行首非 #）",
            "    $activePattern = '(?m)^\\s*include\\s*=\\s*\"~~/custom-opts\\.conf\"'",
            "    if ($content -match $activePattern) {",
            "        Write-Host \"mpv.conf 中已存在生效的 include 选项，跳过。\" -ForegroundColor Green",
            "    }",
            "    else {",
            "        # 2. 存在被注释的 include 行，去掉行首的 # 号（保留前导空白与行尾说明）",
            "        $commentedPattern = '(?m)^(\\s*)#\\s*(include\\s*=\\s*\"~~/custom-opts\\.conf\")'",
            "        if ($content -match $commentedPattern) {",
            "            $content = $content -replace $commentedPattern, '$1$2'",
            "            [System.IO.File]::WriteAllText($mpvConfPath, $content, $utf8NoBom)",
            "            Write-Host \"已取消 mpv.conf 中 include 选项的注释。\" -ForegroundColor Green",
            "        }",
            "        else {",
            "            # 3. 都没有，在末尾追加",
            "            if ($content.Length -gt 0 -and -not $content.EndsWith(\"`n\")) {",
            "                $content += \"`n\"",
            "            }",
            "            $content += \"`ninclude = \"\"~~/custom-opts.conf\"\"`n\"",
            "            [System.IO.File]::WriteAllText($mpvConfPath, $content, $utf8NoBom)",
            "            Write-Host \"已在 mpv.conf 末尾追加 include 选项。\" -ForegroundColor Green",
            "        }",
            "    }",
            "} else {",
            "    Write-Host \"警告：未找到 mpv.conf，跳过 include 选项的开启。\" -ForegroundColor Yellow",
            "}",
            "",
            "# 若 custom-opts.conf 不存在则创建空文件，避免 include 找不到文件报警告",
            "$customOptsPath = Join-Path $mpvConfigDir 'custom-opts.conf'",
            "if (-not (Test-Path $customOptsPath)) {",
            "    New-Item -ItemType File -Path $customOptsPath -Force | Out-Null",
            "    Write-Host \"已创建空的 custom-opts.conf。\" -ForegroundColor Green",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$mpvConfigDir = Join-Path $scoopdir 'persist\\mpv\\portable_config'",
            "if (Test-Path $mpvConfigDir) {",
            "    Write-Host \"正在从 $mpvConfigDir 移除配置（保留 custom-opts.conf）...\" -ForegroundColor Yellow",
            "    Get-ChildItem -LiteralPath $mpvConfigDir -Force |",
            "        Where-Object { $_.Name -ne 'custom-opts.conf' } |",
            "        Remove-Item -Recurse -Force -ErrorAction SilentlyContinue",
            "    Write-Host \"已完成清理，custom-opts.conf 已保留。\" -ForegroundColor Green",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/akFace/mpv.config"
    },
    "autoupdate": {
        "url": "https://github.com/akFace/mpv.config/releases/download/v$version/modern_glass_zh.zip"
    }
}
