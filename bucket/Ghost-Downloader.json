{
    "version": "4.5.3",
    "description": "跨平台多线程下载器，支持 HTTP/FTP/BitTorrent/M3U8/MPEG-DASH/eD2k，可嗅探网页媒体并录制直播流。",
    "homepage": "https://gd.xychr.com/",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v4.5.3/Ghost-Downloader-v4.5.3-Windows-x86_64.zip",
            "hash": "17ffcf953668901d5e00d46643394460da85f88cd2bec69847d4dd6aadcd19eb"
        },
        "arm64": {
            "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v4.5.3/Ghost-Downloader-v4.5.3-Windows-arm64.zip",
            "hash": "74a9b0e9518e35cd5735aaab118924d706dec2bd0533a5412afc6c8fffcd5418"
        }
    },
    "bin": [
        "bin\\ghd.exe",
        "Ghost-Downloader-3.exe"
    ],
    "shortcuts": [
        [
            "Ghost-Downloader-3.exe",
            "Ghost Downloader"
        ]
    ],
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\GhostDownloader\")) {",
        "    New-Item \"$persist_dir\\GhostDownloader\" -ItemType Directory -Force | Out-Null",
        "}"
    ],
    "post_install": [
        "# 文件关联：仅当条目已存在时更新路径，避免创建孤立的注册表项",
        "$schemeKey = 'HKCU:\\Software\\Classes\\ghostdownloader\\shell\\open\\command'",
        "if (Test-Path $schemeKey) { Set-ItemProperty -Path $schemeKey -Name '(default)' -Value \"`\"$dir\\Ghost-Downloader-3.exe`\" `\"%1`\"\" }",
        "",
        "# 开机启动：仅当条目已存在时更新路径",
        "$runKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "if ((Get-ItemProperty -Path $runKey -Name 'GhostDownloader' -ErrorAction SilentlyContinue).GhostDownloader) { Set-ItemProperty -Path $runKey -Name 'GhostDownloader' -Value \"`\"$dir\\Ghost-Downloader-3.exe`\" --silence\" }"
    ],
    "pre_uninstall": [
        "# 清理可能由 post_install 更新的注册表项（如果软件自身未移除）",
        "$schemeKey = 'HKCU:\\Software\\Classes\\ghostdownloader\\shell\\open\\command'",
        "if (Test-Path $schemeKey) { Remove-Item -Path 'HKCU:\\Software\\Classes\\ghostdownloader' -Recurse -Force -ErrorAction SilentlyContinue }"
    ],
    "persist": "GhostDownloader",
    "checkver": {
        "github": "https://github.com/XiaoYouChR/Ghost-Downloader-3"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v$version/Ghost-Downloader-v$version-Windows-x86_64.zip"
            },
            "arm64": {
                "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v$version/Ghost-Downloader-v$version-Windows-arm64.zip"
            }
        }
    }
}
