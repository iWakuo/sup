{
    "version": "1.26.2734.0",
    "description": "新的 Windows 终端，为 Windows 提供标签命令行体验 | The new Windows Terminal, a tabbed command line experience for Windows",
    "homepage": "https://github.com/microsoft/terminal",
    "license": {
        "identifier": "MIT"
    },
    "extract_to": "Deploy",
    "architecture": {
        "64bit": {
            "url": "https://github.com/microsoft/terminal/releases/download/v1.26.2734.0/Microsoft.WindowsTerminalPreview_1.26.2734.0_8wekyb3d8bbwe.msixbundle#/dl.7z",
            "hash": "dbc240a34e327fa65fc5edabe523a55cdc3a1b165f067e291c165cdc811269dd",
            "pre_install": [
                "Get-ChildItem \"$dir\\Deploy\\*x64*.msix\" | ForEach-Object { Expand-7zipArchive $_.FullName $dir }",
                "Remove-Item \"$dir\\Deploy\" -Recurse -Force -ErrorAction SilentlyContinue",
                "Remove-Item \"$dir\\AppxSignature.p7x\" -Force -ErrorAction SilentlyContinue"
            ]
        },
        "arm64": {
            "url": "https://github.com/microsoft/terminal/releases/download/v1.26.2734.0/Microsoft.WindowsTerminalPreview_1.26.2734.0_8wekyb3d8bbwe.msixbundle#/dl.7z",
            "hash": "dbc240a34e327fa65fc5edabe523a55cdc3a1b165f067e291c165cdc811269dd",
            "pre_install": [
                "Get-ChildItem \"$dir\\Deploy\\*arm64*.msix\" | ForEach-Object { Expand-7zipArchive $_.FullName $dir }",
                "Remove-Item \"$dir\\Deploy\" -Recurse -Force -ErrorAction SilentlyContinue",
                "Remove-Item \"$dir\\AppxSignature.p7x\" -Force -ErrorAction SilentlyContinue"
            ]
        }
    },
    "installer": {
        "script": [
            "if (!(Test-Path \"$dir\\AppxManifest.xml\")) { throw 'AppxManifest.xml not found after extracting .msix, check pre_install' }",
            "Add-AppxPackage -Path \"$dir\\AppxManifest.xml\" -Register"
        ]
    },
    "post_install": [
        "$packageDir = Join-Path $env:LOCALAPPDATA 'Packages\\Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe'",
        "$localState = Join-Path $packageDir 'LocalState'",
        "$persistState = Join-Path $persist_dir 'LocalState'",
        "if (!(Test-Path $persistState)) { New-Item -ItemType Directory -Path $persistState -Force | Out-Null }",
        "if (!(Test-Path $packageDir)) { New-Item -ItemType Directory -Path $packageDir -Force | Out-Null }",
        "if (Test-Path $localState) {",
        "    $item = Get-Item $localState -Force",
        "    if ($item.LinkType -eq 'Junction') {",
        "        cmd /c rmdir \"$localState\"",
        "    } else {",
        "        $persistHasData = (Get-ChildItem $persistState -ErrorAction SilentlyContinue).Count -gt 0",
        "        if (-not $persistHasData) {",
        "            Copy-Item \"$localState\\*\" $persistState -Recurse -Force -ErrorAction SilentlyContinue",
        "        }",
        "        Remove-Item $localState -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "New-Item -ItemType Junction -Path $localState -Target $persistState | Out-Null"
    ],
    "pre_uninstall": [
        "$packageDir = Join-Path $env:LOCALAPPDATA 'Packages\\Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe'",
        "$localState = Join-Path $packageDir 'LocalState'",
        "if (Test-Path $localState) {",
        "    $item = Get-Item $localState -Force",
        "    if ($item.LinkType -eq 'Junction') {",
        "        cmd /c rmdir \"$localState\"",
        "    } else {",
        "        Remove-Item $localState -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "Get-AppxPackage -Name 'Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe' | Remove-AppxPackage -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.WindowsTerminal.Preview",
            "ext": "msixbundle"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/microsoft/terminal/releases/download/v$version/Microsoft.WindowsTerminalPreview_$version_8wekyb3d8bbwe.msixbundle#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/microsoft/terminal/releases/download/v$version/Microsoft.WindowsTerminalPreview_$version_8wekyb3d8bbwe.msixbundle#/dl.7z"
            }
        }
    }
}
