{
    "version": "0.1.25",
    "description": "A native desktop music player built with Go.",
    "homepage": "https://github.com/egoist/mygo-music",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/egoist/mygo-music/releases/download/v0.1.25/mygo-music-setup-0.1.25-amd64.exe",
            "hash": "6128d72d3783b41a9360e32f6332fb473d9ad2c385382fd95bce29a227ae82f1"
        },
        "arm64": {
            "url": "https://github.com/egoist/mygo-music/releases/download/v0.1.25/mygo-music-setup-0.1.25-arm64.exe",
            "hash": "39ab7d68203639631f8668a5141ce963cd9870afda2eda007415af013c3a6873"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive -Path \"$dir\\$fname\" -DestinationPath $dir",
            "Remove-Item \"$dir\\$fname\" -Force -ErrorAction SilentlyContinue",
            "Remove-Item (Join-Path $dir '$PLUGINSDIR') -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item (Join-Path $dir 'Uninstall.exe') -Force -ErrorAction SilentlyContinue"
        ]
    },
    "post_install": [
        "$localAppData = Join-Path $env:LOCALAPPDATA 'MyGo Music'",
        "$roamingAppData = Join-Path $env:APPDATA 'MyGo Music'",
        "$persistLocal = Join-Path $persist_dir 'Local'",
        "$persistRoaming = Join-Path $persist_dir 'Roaming'",
        "New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
        "if ((Test-Path $localAppData) -and -not (Get-Item $localAppData -Force).LinkType) {",
        "    if (Test-Path $persistLocal) {",
        "        Get-ChildItem -Path $localAppData -Force | Move-Item -Destination $persistLocal -Force -ErrorAction SilentlyContinue",
        "        Remove-Item $localAppData -Recurse -Force -ErrorAction SilentlyContinue",
        "    } else {",
        "        Move-Item -Path $localAppData -Destination $persistLocal -Force",
        "    }",
        "}",
        "if ((Test-Path $roamingAppData) -and -not (Get-Item $roamingAppData -Force).LinkType) {",
        "    if (Test-Path $persistRoaming) {",
        "        Get-ChildItem -Path $roamingAppData -Force | Move-Item -Destination $persistRoaming -Force -ErrorAction SilentlyContinue",
        "        Remove-Item $roamingAppData -Recurse -Force -ErrorAction SilentlyContinue",
        "    } else {",
        "        Move-Item -Path $roamingAppData -Destination $persistRoaming -Force",
        "    }",
        "}",
        "New-Item -ItemType Directory -Path $persistLocal -Force | Out-Null",
        "New-Item -ItemType Directory -Path $persistRoaming -Force | Out-Null",
        "if (-not (Test-Path $localAppData)) { New-Item -ItemType Junction -Path $localAppData -Target $persistLocal | Out-Null }",
        "if (-not (Test-Path $roamingAppData)) { New-Item -ItemType Junction -Path $roamingAppData -Target $persistRoaming | Out-Null }",
        "$protocolKey = 'HKCU:\\Software\\Classes\\mygo-music'",
        "if (-not (Test-Path $protocolKey)) {",
        "    New-Item -Path $protocolKey -Force | Out-Null",
        "    Set-ItemProperty -Path $protocolKey -Name '(Default)' -Value 'URL:mygo-music Protocol' -Force",
        "    Set-ItemProperty -Path $protocolKey -Name 'URL Protocol' -Value '' -Force",
        "    $commandKey = Join-Path $protocolKey 'shell\\open\\command'",
        "    New-Item -Path $commandKey -Force | Out-Null",
        "    $exePath = Join-Path $dir 'MyGo Music.exe'",
        "    $q = [char]34",
        "    $cmdValue = ($q + $exePath + $q + ' \"%1\"')",
        "    Set-ItemProperty -Path $commandKey -Name '(Default)' -Value $cmdValue -Force",
        "}"
    ],
    "uninstaller": {
        "script": [
            "$localAppData = Join-Path $env:LOCALAPPDATA 'MyGo Music'",
            "$roamingAppData = Join-Path $env:APPDATA 'MyGo Music'",
            "if ((Test-Path $localAppData) -and (Get-Item $localAppData -Force).LinkType) { [System.IO.Directory]::Delete($localAppData, $false) }",
            "if ((Test-Path $roamingAppData) -and (Get-Item $roamingAppData -Force).LinkType) { [System.IO.Directory]::Delete($roamingAppData, $false) }",
            "$protocolKey = 'HKCU:\\Software\\Classes\\mygo-music'",
            "if (Test-Path $protocolKey) {",
            "    $commandKey = Join-Path $protocolKey 'shell\\open\\command'",
            "    if (Test-Path $commandKey) {",
            "        $registeredPath = (Get-ItemProperty -Path $commandKey -Name '(Default)' -ErrorAction SilentlyContinue).'(default)'",
            "        if ($registeredPath -and $registeredPath -like \"*$dir*\") {",
            "            Remove-Item -Path $protocolKey -Recurse -Force -ErrorAction SilentlyContinue",
            "        }",
            "    }",
            "}"
        ]
    },
    "bin": [
        [
            "MyGo Music.exe",
            "mygo-music"
        ]
    ],
    "shortcuts": [
        [
            "MyGo Music.exe",
            "MyGo Music"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/egoist/mygo-music/releases/download/v$version/mygo-music-setup-$version-amd64.exe"
            },
            "arm64": {
                "url": "https://github.com/egoist/mygo-music/releases/download/v$version/mygo-music-setup-$version-arm64.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "regex": "$sha256\\s+$basename"
        }
    }
}
