{
    "version": "0.1.13",
    "description": "ElyDoc: an offline-first word processor for DOCX and ODT files, powered by LibreOfficeKit. Part of the Ely Office suite.",
    "homepage": "https://github.com/ELY-Open-Source/ElyOffice",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ELY-Open-Source/ElyOffice/releases/download/v0.1.13/ElyDoc-0.1.13-windows-x86_64-setup.exe",
            "hash": "0d75aa3f8eac5577df5f7dd1b408aecec6e2d0904378f66441b5e521cd4befb0"
        }
    },
    "installer": {
        "script": [
            "Get-ChildItem \"$dir\\*-setup.exe\" | Select-Object -First 1 | ForEach-Object {",
            "    Expand-7zipArchive -Path $_.FullName -DestinationPath $dir -Removal -Switches '-xr!$PLUGINSDIR -xr!uninstall.exe'",
            "}"
        ]
    },
    "bin": "ely-doc.exe",
    "shortcuts": [
        [
            "ely-doc.exe",
            "ElyDoc"
        ]
    ],
    "post_install": [
        "$nsisStartMenu = Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\ElyDoc.lnk'",
        "if (Test-Path $nsisStartMenu) { Remove-Item $nsisStartMenu -Force }",
        "$nsisDesktop = Join-Path ([Environment]::GetFolderPath('Desktop')) 'ElyDoc.lnk'",
        "if (Test-Path $nsisDesktop) { Remove-Item $nsisDesktop -Force }",
        "$baseDir = Join-Path $env:LOCALAPPDATA 'ElyOffice'",
        "$sharedPersist = Join-Path (Split-Path $persist_dir -Parent) 'ElyOffice'",
        "if (-not (Test-Path $sharedPersist)) { New-Item -ItemType Directory -Path $sharedPersist -Force | Out-Null }",
        "if (Test-Path $baseDir) {",
        "    $item = Get-Item $baseDir",
        "    if ($item.LinkType -ne 'Junction') {",
        "        Get-ChildItem -Path $baseDir -Force | ForEach-Object { Copy-Item -Path $_.FullName -Destination $sharedPersist -Recurse -Force }",
        "        Remove-Item -Path $baseDir -Recurse -Force",
        "    }",
        "}",
        "if (-not (Test-Path $baseDir)) { New-Item -ItemType Junction -Path $baseDir -Target $sharedPersist | Out-Null }",
        "$appDataDir = Join-Path $baseDir 'ely-doc'",
        "$persistDir = $persist_dir",
        "if (-not (Test-Path $persistDir)) { New-Item -ItemType Directory -Path $persistDir -Force | Out-Null }",
        "if (Test-Path $appDataDir) {",
        "    $item = Get-Item $appDataDir",
        "    if ($item.LinkType -ne 'Junction') {",
        "        Get-ChildItem -Path $appDataDir -Force | ForEach-Object { Copy-Item -Path $_.FullName -Destination $persistDir -Recurse -Force }",
        "        Remove-Item -Path $appDataDir -Recurse -Force",
        "    }",
        "}",
        "if (-not (Test-Path $appDataDir)) { New-Item -ItemType Junction -Path $appDataDir -Target $persistDir | Out-Null }",
        "$extKey = 'HKCU:\\Software\\Classes\\.docx'",
        "$progId = 'ElyDoc.Document'",
        "if (-not (Test-Path $extKey)) { New-Item -Path $extKey -Force | Out-Null }",
        "Set-Item -Path $extKey -Value $progId -Force",
        "$progIdKey = \"HKCU:\\Software\\Classes\\$progId\"",
        "if (-not (Test-Path $progIdKey)) { New-Item -Path $progIdKey -Force | Out-Null }",
        "Set-Item -Path $progIdKey -Value 'ElyDoc Document' -Force",
        "New-ItemProperty -Path $progIdKey -Name 'FriendlyTypeName' -Value 'ElyDoc Document' -PropertyType String -Force | Out-Null",
        "$shellNew = \"$extKey\\ShellNew\"",
        "if (-not (Test-Path $shellNew)) { New-Item -Path $shellNew -Force | Out-Null }",
        "New-ItemProperty -Path $shellNew -Name 'NullFile' -Value '' -PropertyType String -Force | Out-Null",
        "Remove-ItemProperty -Path $shellNew -Name 'FileName' -Force -ErrorAction SilentlyContinue",
        "Write-Host 'ElyDoc: New menu item registered (NullFile). Restart Explorer to apply.'"
    ],
    "pre_uninstall": [
        "$nsisStartMenu = Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\ElyDoc.lnk'",
        "if (Test-Path $nsisStartMenu) { Remove-Item $nsisStartMenu -Force }",
        "$nsisDesktop = Join-Path ([Environment]::GetFolderPath('Desktop')) 'ElyDoc.lnk'",
        "if (Test-Path $nsisDesktop) { Remove-Item $nsisDesktop -Force }",
        "$baseDir = Join-Path $env:LOCALAPPDATA 'ElyOffice'",
        "$appDataDir = Join-Path $baseDir 'ely-doc'",
        "if (Test-Path $appDataDir) {",
        "    $item = Get-Item $appDataDir",
        "    if ($item.LinkType -eq 'Junction') { Remove-Item -Path $appDataDir -Force }",
        "}",
        "$extKey = 'HKCU:\\Software\\Classes\\.docx'",
        "$progId = 'ElyDoc.Document'",
        "$shellNew = \"$extKey\\ShellNew\"",
        "$currentProgId = (Get-Item -Path $extKey -ErrorAction SilentlyContinue).GetValue('')",
        "if ($currentProgId -eq $progId) {",
        "    Remove-Item -Path $extKey -Force -ErrorAction SilentlyContinue",
        "    Remove-Item -Path \"HKCU:\\Software\\Classes\\$progId\" -Recurse -Force -ErrorAction SilentlyContinue",
        "} else {",
        "    if (Test-Path $shellNew) { Remove-ItemProperty -Path $shellNew -Name 'NullFile' -Force -ErrorAction SilentlyContinue }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/ELY-Open-Source/ElyOffice",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ELY-Open-Source/ElyOffice/releases/download/v$version/ElyDoc-$version-windows-x86_64-setup.exe",
                "hash": {
                    "url": "https://github.com/ELY-Open-Source/ElyOffice/releases/download/v$version/ely-doc-windows-x86_64.json",
                    "jsonpath": "$.assets.windows-x86_64.sha256"
                }
            }
        }
    }
}
