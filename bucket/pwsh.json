{
    "version": "7.6.8",
    "description": "Cross-platform automation and configuration tool/framework, known as PowerShell Core.",
    "homepage": "https://microsoft.com/PowerShell",
    "license": "MIT",
    "extract_to": "Deploy",
    "architecture": {
        "64bit": {
            "url": "https://github.com/PowerShell/PowerShell/releases/download/v7.6.8/PowerShell-7.6.8.msixbundle#/dl.7z",
            "hash": "a77ef80d069c342739211904b7917769c190dd0c9ccbe492f21d637f318b5e96",
            "pre_install": "Get-ChildItem \"$dir\\Deploy\\*x64*.msix\" | ForEach-Object { Expand-7zipArchive $_.FullName $dir }"
        },
        "arm64": {
            "url": "https://github.com/PowerShell/PowerShell/releases/download/v7.6.8/PowerShell-7.6.8.msixbundle#/dl.7z",
            "hash": "a77ef80d069c342739211904b7917769c190dd0c9ccbe492f21d637f318b5e96",
            "pre_install": "Get-ChildItem \"$dir\\Deploy\\*arm64*.msix\" | ForEach-Object { Expand-7zipArchive $_.FullName $dir }"
        }
    },
    "installer": {
        "script": [
            "if (!(Test-Path \"$dir\\AppxManifest.xml\")) { throw \"AppxManifest.xml not found after extracting .msix\" }",
            "Remove-Item \"$dir\\AppxSignature.p7x\" -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\Deploy\" -Recurse -Force -ErrorAction SilentlyContinue",
            "Add-AppxPackage -Path \"$dir\\AppxManifest.xml\" -Register"
        ]
    },
    "post_install": [
        "$targets = @(",
        "    @{ User = \"$home\\Documents\\PowerShell\"; Persist = \"$persist_dir\\Documents\\PowerShell\" },",
        "    @{ User = \"$env:AppData\\Microsoft\\Windows\\PowerShell\"; Persist = \"$persist_dir\\AppData\\Microsoft\\Windows\\PowerShell\" }",
        ")",
        "foreach ($t in $targets) {",
        "    New-Item -ItemType Directory -Path $t.Persist -Force | Out-Null",
        "    $parent = Split-Path $t.User -Parent",
        "    if (!(Test-Path $parent)) { New-Item -ItemType Directory -Path $parent -Force | Out-Null }",
        "    if (Test-Path $t.User) {",
        "        $item = Get-Item $t.User -Force",
        "        if ($item.LinkType -eq 'Junction') {",
        "            cmd /c rmdir \"$($t.User)\"",
        "        } else {",
        "            Copy-Item \"$($t.User)\\*\" $t.Persist -Recurse -Force -ErrorAction SilentlyContinue",
        "            Get-ChildItem -Path $t.User -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue",
        "            Remove-Item -Path $t.User -Force -ErrorAction SilentlyContinue",
        "        }",
        "    }",
        "    New-Item -ItemType Junction -Path $t.User -Target $t.Persist | Out-Null",
        "}"
    ],
    "bin": "pwsh.exe",
    "shortcuts": [
        [
            "pwsh.exe",
            "PowerShell Core 7"
        ]
    ],
    "pre_uninstall": [
        "$targets = @(",
        "    @{ User = \"$home\\Documents\\PowerShell\"; Persist = \"$persist_dir\\Documents\\PowerShell\" },",
        "    @{ User = \"$env:AppData\\Microsoft\\Windows\\PowerShell\"; Persist = \"$persist_dir\\AppData\\Microsoft\\Windows\\PowerShell\" }",
        ")",
        "foreach ($t in $targets) {",
        "    if (Test-Path $t.User) {",
        "        $item = Get-Item $t.User -Force",
        "        if ($item.LinkType -eq 'Junction') {",
        "            cmd /c rmdir \"$($t.User)\"",
        "        } else {",
        "            Copy-Item \"$($t.User)\\*\" $t.Persist -Recurse -Force -ErrorAction SilentlyContinue",
        "            Get-ChildItem -Path $t.User -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue",
        "            Remove-Item -Path $t.User -Force -ErrorAction SilentlyContinue",
        "        }",
        "    }",
        "}",
        "Get-AppxPackage -PackageFamilyName \"Microsoft.PowerShell_8wekyb3d8bbwe\" | Remove-AppxPackage -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "github": "https://github.com/PowerShell/PowerShell"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/PowerShell/PowerShell/releases/download/v$version/PowerShell-$version.msixbundle#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/PowerShell/PowerShell/releases/download/v$version/PowerShell-$version.msixbundle#/dl.7z"
            }
        }
    }
}
