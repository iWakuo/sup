    },
    "bin": "c001apk.exe",
    "shortcuts": [
        ["c001apk.exe", "c001apk"]
    ],
    "post_install": [
        "$target = Join-Path $env:APPDATA 'bggRGjQaUbCoE'",
        "$persist = $persist_dir",
        "if ((Get-Item -LiteralPath $target -ErrorAction SilentlyContinue).LinkType -eq 'Junction') {",
        "    (Get-Item -LiteralPath $target -Force).Delete()",
        "}",
        "if (-not (Test-Path -LiteralPath $persist)) {",
        "    New-Item -ItemType Directory -Path $persist -Force | Out-Null",
        "}",
        "if ((Test-Path -LiteralPath $target) -and -not (Get-Item -LiteralPath $target -Force).LinkType) {",
        "    Copy-Item -Path (Join-Path $target '*') -Destination $persist -Recurse -Force",
        "    Remove-Item -LiteralPath $target -Recurse -Force",
        "}",
        "New-Item -ItemType Junction -Path $target -Target $persist | Out-Null"
    ],
    "post_uninstall": [
        "$target = Join-Path $env:APPDATA 'bggRGjQaUbCoE'",
        "if ((Get-Item -LiteralPath $target -ErrorAction SilentlyContinue).LinkType -eq 'Junction') {",
        "    (Get-Item -LiteralPath $target -Force).Delete()",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/TG-Twilight/c001apk",
        "regex": "([\\d.]+)-release"
    },
    "autoupdate": {
