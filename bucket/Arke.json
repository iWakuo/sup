{
    "version": "0.10.1",
    "description": "永远不卡的 Windows 文件管理器。GPU 渲染，用 Rust 写成，只有一个小小的 exe。",
    "homepage": "https://github.com/Koimsurai/Arke",
    "license": "Unknown",
    "url": "https://github.com/Koimsurai/Arke/releases/download/v0.10.1/arke-0.10.1.exe#/arke.exe",
    "hash": "3371bb41ee2b60a6e9562548a1956864ecce700f500eada719299cd54aa727c6",
    "bin": "arke.exe",
    "shortcuts": [
        [
            "arke.exe",
            "Arke"
        ]
    ],
    "persist": [
        "Local",
        "Roaming"
    ],
    "post_install": [
        "$links = @(",
        "    @{Link=\"$env:LOCALAPPDATA\\Arke\"; Target=\"$persist_dir\\Local\"},",
        "    @{Link=\"$env:APPDATA\\Arke\"; Target=\"$persist_dir\\Roaming\"}",
        ")",
        "foreach ($l in $links) {",
        "    if (!(Test-Path $l.Target)) { New-Item -Path $l.Target -ItemType Directory -Force | Out-Null }",
        "    if ((Test-Path $l.Link) -and -not ((Get-Item $l.Link).LinkType)) {",
        "        Write-Host \"Backing up existing data from $($l.Link)...\"",
        "        Copy-Item -Path $l.Link -Destination $l.Target -Recurse -Force",
        "        Remove-Item -Path $l.Link -Recurse -Force",
        "    }",
        "    if (!(Test-Path $l.Link)) {",
        "        New-Item -Path $l.Link -ItemType Junction -Value $l.Target -Force | Out-Null",
        "        Write-Host \"Linked $($l.Link) -> $($l.Target)\"",
        "    }",
        "}"
    ],
    "pre_uninstall": [
        "$links = @(\"$env:LOCALAPPDATA\\Arke\", \"$env:APPDATA\\Arke\")",
        "foreach ($l in $links) {",
        "    if ((Test-Path $l) -and ((Get-Item $l).LinkType -eq 'Junction')) { Remove-Item -Path $l -Force }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/Koimsurai/Arke/releases/download/v$version/arke-$version.exe#/arke.exe",
        "hash": {
            "url": "https://github.com/Koimsurai/Arke/releases/download/v$version/arke-$version.exe.sha256"
        }
    }
}
