{
    "version": "1.0.58",
    "description": "A modern file manager for Windows with multi-tab, multi-pane, quick preview, and powerful search.",
    "homepage": "https://github.com/jimmgreen/pulse",
    "license": "MIT",
    "url": "https://github.com/jimmgreen/pulse/releases/download/v1.0.58/PulseSetup-1.0.58.exe",
    "hash": "a2dee2348b610bb3dc4882fe80ea8dd94dcef73bb6ca2e7808585ad932ccbe6c",
    "installer": {
        "script": [
            "Start-Process -FilePath \"$dir\\PulseSetup-$version.exe\" -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', \"/DIR=`\"$dir`\"\" -Wait"
        ]
    },
    "post_install": [
        "$globalStartMenu = Join-Path $env:ProgramData 'Microsoft\\Windows\\Start Menu\\Programs\\Pulse'",
        "if (Test-Path $globalStartMenu) {",
        "    $removeScript = \"Remove-Item -LiteralPath '$globalStartMenu' -Force -Recurse -ErrorAction SilentlyContinue\"",
        "    Start-Process powershell -ArgumentList '-NoProfile', '-Command', $removeScript -Verb RunAs -Wait",
        "}",
        "if (-not (Test-Path $persist_dir)) { New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null }",
        "$dataDir = \"$env:LOCALAPPDATA\\Pulse\"",
        "if (Test-Path $dataDir) {",
        "    Move-Item -Path \"$dataDir\\*\" -Destination $persist_dir -Force -ErrorAction SilentlyContinue",
        "    Remove-Item -Path $dataDir -Force -Recurse -ErrorAction SilentlyContinue",
        "}",
        "New-Item -ItemType Junction -Path $dataDir -Target $persist_dir -Force | Out-Null",
        "$unins = Get-ChildItem -Path $dir -Filter 'unins*.exe' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($unins) { $unins.FullName | Out-File -FilePath \"$dir\\uninstaller.path\" -Encoding ascii -Force }"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $pathFile = \"$dir\\uninstaller.path\"",
            "    if (Test-Path $pathFile) {",
            "        $uninsPath = (Get-Content $pathFile -Raw).Trim()",
            "        if ($uninsPath -and (Test-Path $uninsPath)) {",
            "            Start-Process -FilePath $uninsPath -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART' -Wait",
            "        }",
            "    }",
            "}"
        ]
    },
    "pre_uninstall": [
        "$globalStartMenu = Join-Path $env:ProgramData 'Microsoft\\Windows\\Start Menu\\Programs\\Pulse'",
        "if (Test-Path $globalStartMenu) {",
        "    $removeScript = \"Remove-Item -LiteralPath '$globalStartMenu' -Force -Recurse -ErrorAction SilentlyContinue\"",
        "    Start-Process powershell -ArgumentList '-NoProfile', '-Command', $removeScript -Verb RunAs -Wait",
        "}",
        "$dataDir = \"$env:LOCALAPPDATA\\Pulse\"",
        "if (Test-Path $dataDir) { Remove-Item -Path $dataDir -Force -Recurse -ErrorAction SilentlyContinue }"
    ],
    "shortcuts": [
        ["Pulse.exe", "Pulse"]
    ],
    "checkver": {
        "github": "https://github.com/jimmgreen/pulse"
    },
    "autoupdate": {
        "url": "https://github.com/jimmgreen/pulse/releases/download/v$version/PulseSetup-$version.exe",
        "hash": {
            "url": "https://github.com/jimmgreen/pulse/releases/download/v$version/update-manifest.json",
            "jsonpath": "$.installer_sha256"
        }
    }
}
