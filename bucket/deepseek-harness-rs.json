{
    "version": "0.1.3-alpha.38",
    "description": "DeepSeek Harness Rust 是 DeepSeek Harness Host 的 Rust 迁移实现，使用正式 dsh web 入口托管浏览器应用。",
    "homepage": "https://github.com/qiu7824/deepseek-harness-rs",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/qiu7824/deepseek-harness-rs/releases/download/v0.1.3-alpha.38-r14/deepseek-harness-rs-v0.1.3-alpha.38-windows-x86_64-flutter-portable.zip",
            "hash": "5a2d3b5f6249c8be4034ef025b535f678ec7125c6e6106ea846967fff37bdc81"
        }
    },
    "extract_dir": "deepseek-harness-rs-v0.1.3-alpha.38-windows-x86_64-flutter",
    "bin": [
        ["dsh_desktop.exe", "dsh"],
        ["host\\deepseek-harness-rs.exe", "dsh-host"]
    ],
    "shortcuts": [
        ["dsh_desktop.exe", "DeepSeek Harness"]
    ],
    "env_set": {
        "DSH_HOME": "$persist_dir\\DeepSeek-Harness"
    },
    "post_install": [
        "# ===== 1. 主程序数据：DSH_HOME 指向无空格 persist 目录，不再创建 Junction =====",
        "$dshHome = Join-Path $persist_dir 'DeepSeek-Harness'",
        "if (!(Test-Path $dshHome)) { New-Item -ItemType Directory -Path $dshHome -Force | Out-Null }",
        "$env:DSH_HOME = $dshHome",
        "",
        "# 清理旧版遗留的 %LOCALAPPDATA%\\DeepSeek Harness Junction（已改由 DSH_HOME 接管）",
        "$oldLocal = Join-Path $env:LOCALAPPDATA 'DeepSeek Harness'",
        "$oldItem = Get-Item $oldLocal -ErrorAction SilentlyContinue",
        "if ($oldItem -and ($oldItem.LinkType -eq 'Junction' -or $oldItem.LinkType -eq 'SymbolicLink')) {",
        "    Remove-Item $oldLocal -Force",
        "}",
        "",
        "# ===== 2. 桌面端数据：保留 Junction，目标改为无空格的 'DeepSeek-Harness-Desktop' =====",
        "$desktopLocal   = Join-Path $env:LOCALAPPDATA 'DeepSeek Harness Desktop'",
        "$desktopPersist = Join-Path $persist_dir 'DeepSeek-Harness-Desktop'",
        "if (!(Test-Path $desktopPersist)) { New-Item -ItemType Directory -Path $desktopPersist -Force | Out-Null }",
        "",
        "# 若已是联接，先移除联接本身（不动 persist 数据）",
        "$desktopItem = Get-Item $desktopLocal -ErrorAction SilentlyContinue",
        "if ($desktopItem -and ($desktopItem.LinkType -eq 'Junction' -or $desktopItem.LinkType -eq 'SymbolicLink')) {",
        "    Remove-Item $desktopLocal -Force",
        "}",
        "",
        "# 若是真实目录（首次安装已有数据），迁移到 persist 后删除",
        "if ((Test-Path $desktopLocal) -and !(Get-Item $desktopLocal -Force).LinkType) {",
        "    Copy-Item -Path (Join-Path $desktopLocal '*') -Destination $desktopPersist -Recurse -Force",
        "    Remove-Item $desktopLocal -Recurse -Force",
        "}",
        "",
        "# 建联接：%LOCALAPPDATA%\\DeepSeek Harness Desktop → $persist_dir/DeepSeek-Harness-Desktop",
        "New-Item -ItemType Junction -Path $desktopLocal -Target $desktopPersist | Out-Null"
    ],
    "persist": [
    "DeepSeek-Harness",
    "DeepSeek-Harness-Desktop"
    ],
    "post_uninstall": [
        "# 清除用户级 DSH_HOME（persist 数据保留）",
        "[Environment]::SetEnvironmentVariable('DSH_HOME', $null, 'User')",
        "",
        "# 仅删除桌面端的 Junction，不动 persist 数据",
        "$desktopLocal = Join-Path $env:LOCALAPPDATA 'DeepSeek Harness Desktop'",
        "$item = Get-Item $desktopLocal -ErrorAction SilentlyContinue",
        "if ($item -and ($item.LinkType -eq 'Junction' -or $item.LinkType -eq 'SymbolicLink')) {",
        "    Remove-Item $desktopLocal -Force",
        "}"
    ],
    "notes": "主程序数据根目录由用户级环境变量 DSH_HOME 指定（基于 Scoop persist 目录下的 DeepSeek-Harness，路径无空格）；桌面端数据通过目录联接 %LOCALAPPDATA%\\DeepSeek Harness Desktop → <persist>/DeepSeek-Harness-Desktop（路径无空格）持久化。卸载时清除 DSH_HOME 变量并移除桌面端联接，persist 数据均保留。",
    "checkver": {
        "github": "https://github.com/qiu7824/deepseek-harness-rs",
        "regex": "v?([\\d.]+-[a-z]+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qiu7824/deepseek-harness-rs/releases/download/v$version-r14/deepseek-harness-rs-v$version-windows-x86_64-flutter-portable.zip",
                "hash": {
                    "url": "https://github.com/qiu7824/deepseek-harness-rs/releases/download/v$version-r14/SHA256SUMS.txt",
                    "regex": "([a-fA-F0-9]{64})\\s+deepseek-harness-rs-v$version-windows-x86_64-flutter-portable\\.zip"
                }
            }
        }
    }
}
