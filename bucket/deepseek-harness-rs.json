{
    "version": "0.1.3-alpha.38",
    "description": "DeepSeek Harness Rust 是 DeepSeek Harness Host 的 Rust 迁移实现，使用正式 dsh web 入口托管浏览器应用。",
    "homepage": "https://github.com/qiu7824/deepseek-harness-rs",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/qiu7824/deepseek-harness-rs/releases/download/v0.1.3-alpha.38-r14/deepseek-harness-rs-v0.1.3-alpha.38-windows-x86_64-flutter-portable.zip",
            "hash": "5a2d3b5f6249c8be4034ef025b535f678ec7125c6e6106ea846967fff37bdc81"
        }
    },
    "extract_dir": "deepseek-harness-rs-v0.1.3-alpha.38-windows-x86_64-flutter",
    "bin": [
        ["dsh_desktop.exe", "dsh"],
        ["host\\deepseek-harness-rs.exe", "dsh-host"]
    ],
    "shortcuts": [
        ["dsh_desktop.exe", "DeepSeek Harness"]
    ],
    "post_install": [
        "$names = @('DeepSeek Harness', 'DeepSeek Harness Desktop')",
        "foreach ($name in $names) {",
        "    $local   = Join-Path $env:LOCALAPPDATA $name",
        "    $persist = Join-Path $persist_dir $name",
        "",
        "    # 1. 确保 scoop/persist 下的真实目录存在",
        "    if (!(Test-Path $persist)) {",
        "        New-Item -ItemType Directory -Path $persist -Force | Out-Null",
        "    }",
        "",
        "    # 2. %LOCALAPPDATA% 下若已是联接，先移除（不动 persist 数据）",
        "    $item = Get-Item $local -ErrorAction SilentlyContinue",
        "    if ($item -and ($item.LinkType -eq 'Junction' -or $item.LinkType -eq 'SymbolicLink')) {",
        "        Remove-Item $local -Force",
        "    }",
        "",
        "    # 3. %LOCALAPPDATA% 下若是真实目录（首次安装已有数据），迁移到 persist 后删除",
        "    if ((Test-Path $local) -and !(Get-Item $local -Force).LinkType) {",
        "        Copy-Item -Path (Join-Path $local '*') -Destination $persist -Recurse -Force",
        "        Remove-Item $local -Recurse -Force",
        "    }",
        "",
        "    # 4. 建联接：%LOCALAPPDATA%\\<name> → scoop/persist/deepseek-harness-rs/<name>",
        "    New-Item -ItemType Junction -Path $local -Target $persist | Out-Null",
        "}"
    ],
    "post_uninstall": [
        "$names = @('DeepSeek Harness', 'DeepSeek Harness Desktop')",
        "foreach ($name in $names) {",
        "    $local = Join-Path $env:LOCALAPPDATA $name",
        "    $item = Get-Item $local -ErrorAction SilentlyContinue",
        "    if ($item -and ($item.LinkType -eq 'Junction' -or $item.LinkType -eq 'SymbolicLink')) {",
        "        # 只删联接本身，不动 scoop/persist 下的真实数据",
        "        Remove-Item $local -Force",
        "    }",
        "}"
    ],
    "notes": "真实数据保存在 ~/scoop/persist/deepseek-harness-rs/ 下；%LOCALAPPDATA%\\DeepSeek Harness 与 %LOCALAPPDATA%\\DeepSeek Harness Desktop 是指向它们的目录联接，升级/重装不会丢失数据。",
    "checkver": {
        "github": "https://github.com/qiu7824/deepseek-harness-rs",
        "regex": "v?([\\d.]+-[a-z]+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qiu7824/deepseek-harness-rs/releases/download/v$version-r14/deepseek-harness-rs-v$version-windows-x86_64-flutter-portable.zip",
                "hash": {
                    "url": "https://github.com/qiu7824/deepseek-harness-rs/releases/download/v$version-r14/SHA256SUMS.txt",
                    "regex": "([a-fA-F0-9]{64})\\s+deepseek-harness-rs-v$version-windows-x86_64-flutter-portable\\.zip"
                }
            }
        }
    }
}
