{
    "version": "10.1.0",
    "description": "AMD ROCm (Radeon Open Compute) runtime and tools for Windows (gfx1150) AMD Ryzen AI 9 HX 370 (Radeon 890M).",
    "homepage": "https://rocm.docs.amd.com/",
    "license": "Unknown",
    "url": "https://stable.repo.amd.com/rocm/core/tarball/therock-dist-windows-gfx1150-10.1.0.tar.gz",
    "hash": "B58D79A319B1267940C8B6397B3D6D714698ED8C74E1F61175AE247A3C2ABBC8",
    "installer": {
        "script": [
        "if (-not $dir -or $dir -notmatch '^[A-Za-z]:\\\\') { throw \"Refusing to install: $dir is not an absolute path.\" }",
        "if ($dir -match '^[A-Za-z]:\\\\?$') { throw \"Refusing to install: $dir is a drive root.\" }",
        "if (Test-Path -LiteralPath (Join-Path $dir 'bin')) { return }",
        "$tmpGz = Join-Path $dir '_rocm_gz'",
        "$tmp = Join-Path $dir '_rocm_tmp'",
        "if (Test-Path -LiteralPath $tmpGz) { Remove-Item -LiteralPath $tmpGz -Recurse -Force }",
        "if (Test-Path -LiteralPath $tmp) { Remove-Item -LiteralPath $tmp -Recurse -Force }",
        "$tar = Get-ChildItem -LiteralPath $dir -Filter '*.tar' -File -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if (-not $tar) {",
        "    $tarGz = Get-ChildItem -LiteralPath $dir -Filter '*.tar.gz' -File -ErrorAction SilentlyContinue | Select-Object -First 1",
        "    if ($tarGz) {",
        "        Expand-7zipArchive -Path $tarGz.FullName -DestinationPath $tmpGz -Removal",
        "        $tar = Get-ChildItem -LiteralPath $tmpGz -Filter '*.tar' -File -ErrorAction SilentlyContinue | Select-Object -First 1",
        "    }",
        "}",
        "if ($tar) {",
        "    Expand-7zipArchive -Path $tar.FullName -DestinationPath $tmp -Removal",
        "    if (Test-Path -LiteralPath (Join-Path $tmp 'bin')) {",
        "        $items = @(Get-ChildItem -LiteralPath $tmp -Force)",
        "    } else {",
        "        $dirs = @(Get-ChildItem -LiteralPath $tmp -Directory -Force)",
        "        if ($dirs.Count -ne 1) { throw 'Unexpected archive layout: no bin/ and not a single top-level directory.' }",
        "        $items = @(Get-ChildItem -LiteralPath $dirs[0].FullName -Force)",
        "    }",
        "    if ($items.Count -eq 0) { throw 'Extracted archive is empty.' }",
        "    foreach ($item in $items) { Move-Item -LiteralPath $item.FullName -Destination $dir -Force }",
        "    if (Test-Path -LiteralPath $tmpGz) { Remove-Item -LiteralPath $tmpGz -Recurse -Force }",
        "    Remove-Item -LiteralPath $tmp -Recurse -Force",
        "} else {",
        "    $topDir = Get-ChildItem -LiteralPath $dir -Directory | Where-Object { $_.Name -like 'therock-dist-windows-*' } | Select-Object -First 1",
        "    if (-not $topDir) { throw 'No .tar/.tar.gz file and no therock-dist-windows-* directory found.' }",
        "    if ($topDir.FullName -match '^[A-Za-z]:\\\\?$') { throw 'Refusing: top dir is a drive root.' }",
        "    $items = @(Get-ChildItem -LiteralPath $topDir.FullName -Force)",
        "    if ($items.Count -eq 0) { throw 'Top-level directory is empty.' }",
        "    foreach ($item in $items) { Move-Item -LiteralPath $item.FullName -Destination $dir -Force }",
        "    Remove-Item -LiteralPath $topDir.FullName -Recurse -Force",
        "}"
    ]
    },
    "env_add_path": [
        "bin",
        "lib\\llvm\\bin"
    ],
    "env_set": {
        "HIP_DEVICE_LIB_PATH": "$dir\\lib\\llvm\\amdgcn\\bitcode",
        "HIP_PATH": "$dir",
        "HIP_PLATFORM": "amd",
        "LLVM_PATH": "$dir\\lib\\llvm"
    },
    "notes": [
        "ROCm 已安装完成。",
        "请打开一个新的终端窗口（或重新登录），使 PATH 和环境变量生效，然后运行以下命令验证安装：",
        "",
        "    hipinfo",
        "",
        "hipinfo 会列出检测到的 AMD GPU，并确认 ROCm 运行时和驱动已正确加载。",
        "如果提示找不到 hipinfo，请检查 PATH 中是否包含以下目录：",
        "    $dir\\bin",
        "    $dir\\lib\\llvm\\bin"
    ],
    "post_uninstall": [
        "if (-not $dir -or $dir -match '^[A-Za-z]:\\\\?$') { return }",
        "$vars = @('HIP_DEVICE_LIB_PATH', 'HIP_PATH', 'HIP_PLATFORM', 'LLVM_PATH')",
        "foreach ($name in $vars) { if ([Environment]::GetEnvironmentVariable($name, 'User')) { [Environment]::SetEnvironmentVariable($name, $null, 'User') } }",
        "$remove = @(\"$dir\\bin\", \"$dir\\lib\\llvm\\bin\") | ForEach-Object { $_.TrimEnd('\\') }",
        "$userPath = [Environment]::GetEnvironmentVariable('Path', 'User')",
        "if ($userPath) { $newPath = ($userPath -split ';' | Where-Object { $p = $_.TrimEnd('\\'); $p -and ($remove -notcontains $p) }) -join ';'; [Environment]::SetEnvironmentVariable('Path', $newPath, 'User') }"
    ],
    "checkver": {
        "url": "https://stable.repo.amd.com/rocm/core/tarball/",
        "regex": "therock-dist-windows-gfx1150-([\\d.]+)\\.tar\\.gz"
    },
    "autoupdate": {
        "url": "https://stable.repo.amd.com/rocm/core/tarball/therock-dist-windows-gfx1150-$version.tar.gz"
    }
}
