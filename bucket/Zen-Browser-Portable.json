{
    "version": "1.24.3b",
    "description": "Zen Browser 便携版，基于 Firefox，数据随目录携带，不写注册表。",
    "homepage": "https://github.com/Piracola/Zen-Portable",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Piracola/Zen-Portable/releases/download/1.24.3b/Zen_1.24.3b.7z",
            "hash": "98a7358a771a90276adf269436e2ddeb2dc540662ca1ae82e19102c663a88049"
        }
    },
    "bin": [
        ["Zen\\zen.exe", "zen"]
    ],
    "shortcuts": [
        ["Zen\\zen.exe", "Zen Browser"]
    ],
    "persist": [
        "Profiles",
        "Cache"
    ],
    "checkver": {
        "github": "https://github.com/Piracola/Zen-Portable",
        "regex": "tag/([\\d.]+[a-z]?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Piracola/Zen-Portable/releases/download/$version/Zen_$version.7z"
            }
        },
        "hash": {
            "url": "https://github.com/Piracola/Zen-Portable/releases/download/$version/Zen_$version.7z.sha256",
            "regex": "^([a-fA-F0-9]{64})"
        }
    }
}
