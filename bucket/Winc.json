{
    "version": "0.1.688",
    "description": "A lightweight, Rust-native code editor with built-in Git and Markdown preview.",
    "homepage": "https://github.com/DEEIX-AI/Winc",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/DEEIX-AI/Winc/releases/download/v0.1.688/Winc-0.1.688-windows-x64.msi",
            "hash": "a22b574d3e450da61c17bc99d6700b66b94063f8f6b74cc6f7f3b5f6006b4971"
        }
    },
    "pre_install": [
        "if (Test-Path \"$dir\\winc\\winc.exe\") { Get-ChildItem -Path \"$dir\\winc\" -Force | Move-Item -Destination $dir -Force; Remove-Item -Path \"$dir\\winc\" -Recurse -Force -ErrorAction SilentlyContinue }",
        "if (Test-Path \"$dir\\WincExe\") { Rename-Item -Path \"$dir\\WincExe\" -NewName \"winc.exe\" -Force }",
        "if (!(Test-Path \"$dir\\data\")) { New-Item -ItemType Directory -Path \"$dir\\data\" -Force | Out-Null }",
        "if (!(Test-Path \"$dir\\winc.exe\")) { Write-Error \"扁平化失败：$dir\\winc.exe 不存在\" }"
    ],
    "post_install": [
        "$appKey = 'HKCU:\\Software\\Classes\\Applications\\winc.exe'",
        "New-Item -Path $appKey -Force | Out-Null",
        "Set-ItemProperty -Path $appKey -Name 'FriendlyAppName' -Value 'Winc' -Type String -Force"
    ],
    "pre_uninstall": "Remove-Item -Path 'HKCU:\\Software\\Classes\\Applications\\winc.exe' -Recurse -Force -ErrorAction SilentlyContinue",
    "bin": "winc.exe",
    "shortcuts": [
        [
            "winc.exe",
            "Winc"
        ]
    ],
    "persist": "data",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/DEEIX-AI/Winc/releases/download/v$version/Winc-$version-windows-x64.msi",
                "hash": {
                    "url": "$baseurl/SHA256SUMS"
                }
            }
        }
    }
}
